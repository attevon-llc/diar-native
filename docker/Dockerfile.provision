# Provisioning image — the FALLBACK path, not the primary one.
#
# The primary way to provision is to run the ordinary `diar-server` binary and let it exec a
# python that already has torch and pyannote.audio:
#
#     HF_TOKEN=... diar-server provision-models --models-dir /models
#
# The export scripts are compiled INTO the binary (`include_str!`, see
# crates/diar-core/src/provision/exporter.rs), so there is nothing to install for the tooling
# itself — only the python libraries the export calls. In OpenTranscribe's backend image most
# of them are already present; only `onnxscript` and a constant folder are missing.
#
# This image exists for operators running the plain standalone `diar-server` image, which has
# NO python at all. It adds ~1.5-2 GB, is pulled once, and can be deleted afterwards. The
# serving images are untouched by it (CUDA stays ~3.46 GB, CPU stays 189 MB) — which is the
# whole reason provisioning is not baked into them: bundling torch would be a ~13x permanent
# regression on every laptop deployment for a step that runs once.
#
# Build (after building the server image it is based on):
#   docker build -f docker/Dockerfile.provision --build-arg BASE=diar-server:<ver> \
#                -t diar-provision:<ver> .
#
# Run (note :rw — the serving compose file mounts /models read-only):
#   docker run --rm -e HF_TOKEN=... -v /path/to/models:/models diar-provision:<ver>
#
# Reuse an existing HuggingFace cache to avoid re-downloading:
#   ... -v /path/to/hf:/hf -e HF_HOME=/hf

ARG BASE=diar-server:latest
FROM ${BASE}

# The base image ends on `USER 10001:10001` (issue #7), so every layer below would fail on a
# permission error without this. Root is reclaimed only to INSTALL; the final USER line at the
# bottom of this file drops back, and no layer here is ever executed at run time.
USER root

ENV DEBIAN_FRONTEND=noninteractive

# python3 + venv only. No compiler and no cmake: every dependency below must resolve to a
# wheel, which is exactly why `onnxslim` is used rather than `onnxsim` when the interpreter
# has no onnxsim wheel (notably CPython 3.13).
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv python3-pip ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY scripts/provision/requirements.txt /opt/diar-provision/requirements.txt

# CPU-ONLY torch, deliberately. The export never touches a GPU — export_models.py does
# `pipeline.to(torch.device("cpu"))` — so the default CUDA wheels would pull ~5 GB of
# nvidia_* packages that are downloaded and then never executed.
# setuptools and msgpack arrive as TRANSITIVE dependencies at versions trivy flags HIGH:
# CVE-2025-47273 (setuptools path traversal in PackageIndex) and GHSA-6v7p-g79w-8964 (msgpack
# out-of-bounds read when an Unpacker is reused after a caught error). Neither is reachable
# from what this image does — it runs one trusted export script, not an index fetch and not
# untrusted msgpack — but scripts/release.sh fails a release on ANY HIGH/CRITICAL rather than
# inviting a per-image judgement call, so they are upgraded rather than argued about. Both have
# fixed versions and neither changes an API this image uses.
#
# Upgraded in the same layer, BEFORE requirements.txt, so pip resolves the pinned floors once
# instead of installing the vulnerable version and then replacing it in a later layer (which
# leaves the old files in the image and keeps the finding).
RUN python3 -m venv /opt/diar-provision/env \
 && /opt/diar-provision/env/bin/pip install --no-cache-dir --upgrade \
      pip 'setuptools>=78.1.1' 'msgpack>=1.2.1' \
 && /opt/diar-provision/env/bin/pip install --no-cache-dir \
      --extra-index-url https://download.pytorch.org/whl/cpu \
      -r /opt/diar-provision/requirements.txt

# Remove the SYSTEM python's pip and setuptools once the venv exists.
#
# They are only ever used to bootstrap the venv above; nothing at runtime touches them, and the
# export runs entirely from /opt/diar-provision/env. But apt's python3-pip ships a VENDORED
# msgpack (GHSA-6v7p-g79w-8964) and an old setuptools egg-info (CVE-2025-47273), both of which
# trivy reports HIGH — on code that is present but unreachable.
#
# Deleting is the honest fix rather than an ignore-file entry: the finding goes away because the
# code is gone, not because we stopped looking. The venv's own copies are already upgraded past
# both advisories, and they are what actually runs.
#
# Note it must happen AFTER the venv is created — python3 -m venv needs system pip to exist.
# Remove pip itself — from the venv AND from the system python — once everything is installed.
#
# Nothing at runtime needs a package installer: `provision-models` runs the export scripts out
# of the venv and never resolves a dependency. Carrying pip is pure attack surface.
#
# It is also the ONLY remaining source of trivy HIGH findings, and not in the way it first
# looks. pip VENDORS its dependencies and (since 26.x) ships a CycloneDX SBOM declaring them:
#
#   pip/_vendor/msgpack/          msgpack 1.1.2   GHSA-6v7p-g79w-8964
#   pip/_vendor/bom.cdx.json      setuptools 70.3.0  CVE-2025-47273
#
# So upgrading setuptools and msgpack in the venv — which we do, and which is why the venv's own
# copies are 84.0.0 and 1.2.2 — could never clear these: the flagged code is INSIDE pip. The
# only honest fixes are to remove pip or to suppress the finding, and removing it is better:
# the code is actually gone, and the image loses a capability it never needed.
#
# Must run AFTER the installs above; `python3 -m venv` and every `pip install` need it to exist.
RUN apt-get purge -y --auto-remove python3-pip >/dev/null 2>&1 || true \
 && rm -rf /usr/lib/python3/dist-packages/pip \
           /usr/lib/python3/dist-packages/pip-*.dist-info \
           /usr/lib/python3/dist-packages/setuptools \
           /usr/lib/python3/dist-packages/setuptools-*.egg-info \
           /usr/lib/python3/dist-packages/pkg_resources \
           /opt/diar-provision/env/lib/python3.12/site-packages/pip \
           /opt/diar-provision/env/lib/python3.12/site-packages/pip-*.dist-info \
 && /opt/diar-provision/env/bin/python -c "import torch, onnx, onnxscript, transformers, huggingface_hub; print('venv intact:', torch.__version__)"

# The scripts themselves are baked into the binary; this copy is for inspection and for
# `diar-server provision-models --dump-scripts`-style debugging, not for execution.
COPY scripts/provision/ /opt/diar-provision/scripts/

# Point the binary's exporter at this venv. Without it the binary would look for `python3` on
# PATH, find the bare system interpreter, and fail the dependency preflight with an
# actionable-but-unnecessary message.
ENV DIAR_EXPORT_PYTHON=/opt/diar-provision/env/bin/python

# HuggingFace cache. The export child resolves `~/.cache/huggingface` when HF_HOME is unset,
# and this image is run with `--user "$(id -u):$(id -g)"` (see below), for which `~` is not
# writable — so an unset HF_HOME is a download failure, not a slow path. /hf is 1777 for the
# same reason /tmp/diar-native is: whatever uid the operator runs as has to be able to write
# it. Bind-mount a host directory here to keep the ~32 MB download warm across re-exports.
ENV HF_HOME=/hf
RUN mkdir -p /hf && chmod 1777 /hf

# /models exists in THIS image, owned by the built-in user, purely so a Docker NAMED VOLUME
# mounted here comes out writable. Docker seeds a fresh named volume's ownership and mode from
# the image directory it is mounted over; when that directory does not exist it creates it
# root:root 0755 instead, and the non-root export then fails with exit 7 on a volume nobody
# ever touched. That is the whole failure mode `docker-compose.prod.yml` avoids — it uses a
# named volume so a no-clone `docker compose up` needs no mkdir, no uid wiring and no chown.
# Measured, not assumed: without this line a fresh `-v vol:/models` is not writable by 10001.
# A bind mount overrides the directory entirely, so this line is inert on that path.
RUN mkdir -p /models && chown 10001:10001 /models

# Back to the base image's non-root user. Note that provisioning is normally run with
# `--user "$(id -u):$(id -g)"` OVERRIDING this, so the exported models land owned by the
# operator rather than by uid 10001 — that is what lets a stranger provision into a plain
# `./models` directory with no chown and no sudo. This line is the floor, not the intent:
# it guarantees that even a bare `docker run diar-provision` is not root.
USER 10001:10001

# Same entrypoint as the server image, so `docker run diar-provision` provisions and
# `docker run diar-provision serve` still serves. Nothing about the server is removed.
ENTRYPOINT ["/usr/local/bin/diar-server"]
CMD ["provision-models"]
