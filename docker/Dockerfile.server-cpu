# syntax=docker/dockerfile:1.7
# diar-server CPU-only runtime image — multi-arch (linux/amd64, linux/arm64).
# No CUDA anywhere in this file: Apple Silicon has no NVIDIA GPU, and CoreML/Metal is not
# reachable through Docker at all (no Metal access on macOS regardless of image arch), so
# there is no GPU acceleration to target on arm64 regardless of base image choice.
#
# This is NOT a correctness carve-out. On amd64 the CUDA image (docker/Dockerfile.server) is a
# strict SUPERSET: the ORT CPU EP is statically linked into the binary in every build, so that
# image serves `cuda` and `cpu` from one process, per request. This file exists for the two
# things the CUDA image cannot do — build for arm64 (its base image and ORT tarball are x86-64
# only), and be small (189 MB vs 3.46 GB, no NVIDIA runtime or driver needed). Prefer the CUDA
# image on amd64 GPU hosts; use this one for arm64, and for amd64 hosts with no GPU where the
# 3.3 GB is not worth paying. The Rust source is identical — only the ort-sys prebuilt
# distribution and the runtime base differ.
#   docker buildx build --platform linux/amd64,linux/arm64 -f docker/Dockerfile.server-cpu \
#     -t <tag> --push .
# Build context: repo root (diar-native/).

# PINNED to 24.04, NOT bumped to 26.04. The 26.04 bump was merged (#11), reverted (1bbba89),
# and has now been SCORED (RESULTS §7.52): on linux/arm64 it is a severe accuracy regression,
# not the cosmetic 8 -> 10 exclusive-segment difference it looks like on the smoke fixture.
# AMI-16 exclusive DER 18.7% -> 52.4%, full DER 13.8% -> 48.7%, with missed detection and
# false alarm IDENTICAL TO THE DIGIT — the entire +33.7 pp is speaker confusion. Embeddings
# survive (centroids match at ~1.0000 cosine); the clustering groups them into the wrong
# number of speakers.
#
# Cause is OpenBLAS 0.3.26 -> 0.3.32, isolated to that one shared object: speakrs is built
# openblas-system, so overwriting only openblas-pthread/ inside the unchanged 26.04 image with
# 24.04's 0.3.26 makes the output byte-identical to the 24.04 image. glibc 2.43 is ruled out.
# amd64 is unaffected on the fixture, matching OpenBLAS 0.3.28/0.3.29's arm64-only GEMM->GEMV
# forwarding; but the fixture is now known to UNDERSTATE this failure, so amd64 has not really
# been cleared either.
#
# DO NOT re-bump this base — and note that `verify-models` CANNOT catch this: it passes every
# stage on the broken build, reporting a plausible 2 speakers / 7 segments while exclusive DER
# is ~52%. A bump needs a real-corpus DER check on each published architecture, run NATIVELY
# (OpenBLAS picks kernels by runtime CPU detection, so a QEMU run proves nothing). See #18.
FROM ubuntu:24.04 AS base
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config cmake ca-certificates curl git \
    libssl-dev libclang-dev libopenblas-dev \
    && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV CARGO_HOME="/root/.cargo" PATH="/root/.cargo/bin:${PATH}" RUSTUP_HOME="/root/.rustup"

FROM base AS ort-download
ARG ORT_VERSION=1.24.2
ARG TARGETARCH
RUN case "${TARGETARCH}" in \
        amd64) ORT_ARCH=x64 ;; \
        arm64) ORT_ARCH=aarch64 ;; \
        *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac && \
    curl -fSL -o /tmp/ort.tgz \
        "https://github.com/microsoft/onnxruntime/releases/download/v${ORT_VERSION}/onnxruntime-linux-${ORT_ARCH}-${ORT_VERSION}.tgz" && \
    mkdir -p /opt/ort-libs && \
    tar xzf /tmp/ort.tgz --strip-components=2 -C /opt/ort-libs --wildcards "*/lib/*.so*" && \
    rm /tmp/ort.tgz

FROM base AS builder
# ARG scope is per-stage: the TARGETARCH declared in ort-download does NOT carry over here.
# Without this re-declaration ${TARGETARCH} expands to empty on line 53, both platforms share
# one cache id, and a multi-platform buildx run contends on cargo's registry lock.
ARG TARGETARCH
WORKDIR /build
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
# rust-toolchain.toml is not decoration here: rustup reads it and installs the pinned
# compiler, so the binary we ship is built by the same toolchain CI ran clippy and the
# tests against. Without it this image would silently use whatever Rust its base
# happens to carry.
COPY crates/ ./crates/
COPY vendor/speakrs/ ./vendor/speakrs/
# Required: diar-core's provision module `include_str!`s scripts/provision/*.py
# (crates/diar-core/src/provision/exporter.rs). Without this the build fails with
# "couldn't read .../scripts/provision/provision.py".
COPY scripts/ ./scripts/
# No --features cuda: cuda is purely additive (diar-core/Cargo.toml), the default build is
# already CPU-mode via openblas-system (pinned in the workspace root Cargo.toml's speakrs dep).
# diar-cli is built here too but is NOT copied into the serving image — see the `cli` target
# below. It shares every compiled dependency with diar-server, so this costs one extra link.
RUN --mount=type=cache,target=/root/.cargo/registry,id=diar-server-cpu-cargo-registry-${TARGETARCH} \
    cargo build --release -p diar-server -p diar-cli && \
    mkdir -p /opt/bin && cp -P target/release/diar-server target/release/diar-cli /opt/bin/

# Shared by the serving image and the `cli` target so the two never diverge and the second
# image costs only its own binary. The serving image remains the LAST stage, so a plain
# `docker build -f docker/Dockerfile.server-cpu .` still produces exactly what it used to.
FROM ubuntu:24.04 AS runtime-base
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    ca-certificates curl libopenblas0 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ort-download /opt/ort-libs/ /usr/local/lib/
RUN ldconfig && ln -s /usr/local/lib/libonnxruntime_providers_*.so /usr/local/bin/ 2>/dev/null || true && \
    mkdir -p /srv && ln -s /usr/local/lib/libonnxruntime_providers_*.so /srv/ 2>/dev/null || true
RUN mkdir -p /tmp/diar-native && chmod 1777 /tmp/diar-native
# Non-root (issue #7). Fixed uid/gid 10001:10001, identical to docker/Dockerfile.server —
# see the long rationale there. Serving writes nothing outside /tmp/diar-native; the
# provisioning path overrides this with `--user "$(id -u):$(id -g)"` so a bind-mounted
# models directory is written with the operator's own ownership and needs no chown.
RUN groupadd --system --gid 10001 diar && \
    useradd --system --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin diar
ENV HOME=/tmp
USER 10001:10001

# ── `cli` target: one-shot diarization, no server ────────────────────────────────────────
#   docker build -f docker/Dockerfile.server-cpu --target cli -t diar-native-cli:local .
# See the matching block in docker/Dockerfile.server for why this is a separate image.
FROM runtime-base AS cli
COPY --from=builder /opt/bin/diar-cli /usr/local/bin/
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/diar-cli"]

# ── serving image (the default target: LAST stage wins) ─────────────────────────────────
FROM runtime-base
COPY --from=builder /opt/bin/diar-server /usr/local/bin/
# Smoke-test fixture for `provision-models` / `verify-models`. 26 s, 16 kHz mono:
# long enough for 3 segmentation chunks, so it exercises multi-chunk aggregation,
# VBx clustering and PLDA rather than just "a session loaded". ~832 KB.
COPY vendor/speakrs/fixtures/test.wav /usr/local/share/diar-native/smoke.wav
WORKDIR /srv
EXPOSE 8701
# Liveness, deliberately NOT readiness. /healthz is 200 whenever the process is serving;
# /readyz is 200 only once the models are provisioned and verified. Using /readyz here would
# mark every not-yet-provisioned container unhealthy, failing `compose up --wait` for the whole
# stack — the exact silent-fallback regression the models-state split exists to prevent.
# Operators who want readiness gating should point their own compose healthcheck at /readyz.
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -fsS http://localhost:8701/healthz || exit 1
ENTRYPOINT ["/usr/local/bin/diar-server"]
