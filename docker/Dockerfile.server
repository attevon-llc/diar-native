# syntax=docker/dockerfile:1.7
# diar-server runtime image (T1 sidecar). Build context: repo root (diar-native/).
#   docker build -f docker/Dockerfile.server -t diar-server:latest .
# Requires the workspace binaries to have been built already OR builds them here.
#
# This image serves BOTH `cuda` and `cpu` — it is a superset of Dockerfile.server-cpu on
# amd64, at zero extra bytes and with no extra libraries. The ORT CPU execution provider is
# STATICALLY LINKED into the binary by ort-sys (the onnxruntime_mlas kernel library is part of
# the core static objects), which is why `ldd diar-server` shows no ONNX Runtime NEEDED entry
# at all; `--features cuda` only selects a different prebuilt ort-sys distribution and adds the
# dlopen'd provider .so files below. Do NOT add the CPU ORT tarball to get a CPU path: it is
# already there, and its libonnxruntime.so.1.24.2 would collide with the GPU tarball's.
# Pick devices at runtime with DIAR_DEVICES (e.g. `cuda,cpu`; first entry is the default) or
# per request with the `device` field; `/healthz` reports both loaded and supported devices.
#
# amd64 ONLY: the base image and the onnxruntime-linux-x64-gpu tarball below are both x86-64,
# and there is no arm64 equivalent. docker/Dockerfile.server-cpu remains the deliberate
# minimal/arm64 artifact (189 MB vs 3.46 GB, no NVIDIA runtime or driver required).

FROM nvidia/cuda:12.8.1-devel-ubuntu24.04 AS base
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config cmake ca-certificates curl git python3 \
    libssl-dev libclang-dev libopenblas-dev libcudnn9-dev-cuda-12 \
    && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV CARGO_HOME="/root/.cargo" PATH="/root/.cargo/bin:${PATH}" RUSTUP_HOME="/root/.rustup"

FROM base AS ort-download
ARG ORT_VERSION=1.24.2
RUN curl -fSL -o /tmp/ort.tgz \
        "https://github.com/microsoft/onnxruntime/releases/download/v${ORT_VERSION}/onnxruntime-linux-x64-gpu-${ORT_VERSION}.tgz" && \
    mkdir -p /opt/ort-libs && \
    tar xzf /tmp/ort.tgz --strip-components=2 -C /opt/ort-libs --wildcards "*/lib/*.so*" && \
    rm /tmp/ort.tgz

FROM base AS builder
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY crates/ ./crates/
COPY vendor/speakrs/ ./vendor/speakrs/
# Required: diar-core's provision module `include_str!`s scripts/provision/*.py
# (crates/diar-core/src/provision/exporter.rs). Without this the build fails with
# "couldn't read .../scripts/provision/provision.py".
COPY scripts/ ./scripts/
RUN --mount=type=cache,target=/root/.cargo/registry,id=diar-server-cargo-registry \
    cargo build --release --features cuda -p diar-server && \
    mkdir -p /opt/bin && cp -P target/release/diar-server /opt/bin/

# -base, not -runtime: the -runtime tag's cuda-libraries-12-8 meta-package drags in
# libcusolver/libcusparse/libnpp/libnvjpeg/libnvjitlink/cufile/opencl — none of which
# libonnxruntime_providers_cuda.so links against (verified via ldd). Only install the
# 3 CUDA math libs it actually needs (cudart ships in -base already) + cudnn. Cuts the
# CUDA layer from ~3.4GB to ~1.6GB with identical runtime behavior.
FROM nvidia/cuda:12.8.1-base-ubuntu24.04
ENV DEBIAN_FRONTEND=noninteractive
# upgrade first: patches HIGH-severity CVEs in base-image packages (gnupg family,
# openssl) that aren't touched by our own install list but ship preinstalled.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    ca-certificates curl libcublas-12-8 libcufft-12-8 libcurand-12-8 libcudnn9-cuda-12 libopenblas0 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /opt/bin/diar-server /usr/local/bin/
# Smoke-test fixture for `provision-models` / `verify-models`. 26 s, 16 kHz mono:
# long enough for 3 segmentation chunks, so it exercises multi-chunk aggregation,
# VBx clustering and PLDA rather than just "a session loaded". ~832 KB.
COPY vendor/speakrs/fixtures/test.wav /usr/local/share/diar-native/smoke.wav
COPY --from=ort-download /opt/ort-libs/ /usr/local/lib/
# TensorRT EP was rolled back (RESULTS §7.26) and libnvinfer/libnvonnxparser are never
# installed — this provider .so is dead weight that can't load; drop it rather than ship
# a file that fails confusingly if anyone ever points DIAR_MODE at tensorrt.
RUN rm -f /usr/local/lib/libonnxruntime_providers_tensorrt.so
# ORT resolves provider libs relative to the executable dir AND cwd — cover both.
RUN ldconfig && ln -s /usr/local/lib/libonnxruntime_providers_*.so /usr/local/bin/ && \
    mkdir -p /srv && ln -s /usr/local/lib/libonnxruntime_providers_*.so /srv/
# Audio handoff volume. A named volume inherits this directory's mode at creation, and the
# calling worker is non-root (appuser) in every deployment we target — without 1777 here the
# volume lands root-owned 0755 and every /diarize write fails with EACCES.
RUN mkdir -p /tmp/diar-native && chmod 1777 /tmp/diar-native
WORKDIR /srv
EXPOSE 8701
ENTRYPOINT ["/usr/local/bin/diar-server"]
