+/// diar-native patch (T11): TensorRT EP for the fixed-shape GPU sessions, opt-in via
+/// `SPEAKRS_TRT=1`. Engines are compiled per GPU on first run and cached at
+/// `SPEAKRS_TRT_CACHE` (default `/tmp/diar-native/trt_cache`) — put that on a persistent
+/// volume or every process start pays the build. fp32 only: fp16 measurably collapses DER
+/// in the StatsPool variance/sqrt subgraph (RESULTS §4.18).
+#[cfg(feature = "tensorrt")]
+pub(crate) fn trt_requested() -> bool {
+    std::env::var("SPEAKRS_TRT")
+        .map(|v| v == "1" || v.eq_ignore_ascii_case("true"))
+        .unwrap_or(false)
+}
+
+#[cfg(not(feature = "tensorrt"))]
+pub(crate) fn trt_requested() -> bool {
+    false
+}
+
+/// Like [`with_execution_mode`], but registers `[TensorRT, CUDA, CPU]` on CUDA modes when
+/// `SPEAKRS_TRT=1`. TensorRT registration is non-fatal: with the TRT libs absent, ORT logs
+/// a warning and the session falls back to the CUDA EP exactly as configured today.
+pub(crate) fn with_execution_mode_trt_preferred(
+    builder: SessionBuilder,
+    mode: ExecutionMode,
+) -> Result<SessionBuilder, ort::Error> {
+    #[cfg(feature = "tensorrt")]
+    if trt_requested() && mode.is_cuda() {
+        mode.validate()?;
+        let cache = std::env::var("SPEAKRS_TRT_CACHE")
+            .unwrap_or_else(|_| "/tmp/diar-native/trt_cache".to_string());
+        let _ = std::fs::create_dir_all(&cache);
+        return Ok(builder.with_execution_providers([
+            ep::TensorRT::default()
+                .with_device_id(0)
+                .with_engine_cache(true)
+                .with_engine_cache_path(&cache)
+                .with_timing_cache(true)
+                .with_timing_cache_path(&cache)
+                .with_fp16(false)
+                .with_max_workspace_size(2 << 30)
+                .build(),
+            ep::CUDA::default()
+                .with_device_id(0)
+                .with_tf32(true)
+                .with_conv_algorithm_search(ep::cuda::ConvAlgorithmSearch::Exhaustive)
+                .with_conv_max_workspace(true)
+                .with_arena_extend_strategy(ep::ArenaExtendStrategy::SameAsRequested)
+                .with_prefer_nhwc(true)
+                .build()
+                .error_on_failure(),
+        ])?);
+    }
+    with_execution_mode(builder, mode)
+}
