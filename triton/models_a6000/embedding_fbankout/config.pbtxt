name: "embedding_fbankout"
platform: "onnxruntime_onnx"
max_batch_size: 0
input [
  { name: "fbank_features" data_type: TYPE_FP32 dims: [ -1, -1, 80 ] },
  { name: "weights" data_type: TYPE_FP32 dims: [ -1, -1 ] }
]
output [ { name: "embeddings" data_type: TYPE_FP32 dims: [ -1, 256 ] } ]
instance_group [ { count: 1 kind: KIND_GPU gpus: [ 0 ] } ]
