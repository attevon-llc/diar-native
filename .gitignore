# vendored upstream clone (pin recorded in validation/RESULTS.md; re-clone to reproduce)
vendor/

# exported model artifacts — derivatives of gated pyannote community-1 weights (CC-BY-4.0,
# terms-gated); regenerate with vendor/speakrs/scripts/export_models.py — never commit.
# The glob has to cover every set (models_folded/, models_small/, …): `models/` alone missed
# models_folded/ when it was added, and 254 MB of gated weights went into history before a
# filter-repo purge took them back out (RESULTS §7.8).
models/
models*/
triton/engines/
triton/engines_a6000/
triton/**/*.onnx
triton/**/*.plan

# local tooling
venv/
__pycache__/
*.pyc

# large/raw benchmark outputs stay local; scored JSONs + RESULTS.md are committed
results/rttm/*/*.log
target/
upstream-work/
venv-export/
